# Dockerfile.test — integration test image
# - Has tmux, Go, and the test binaries
# - Runs as a non-root user with a throwaway HOME
# - Never mounts the developer's HOME

FROM ubuntu:24.04

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Go
RUN curl -sL https://dl.google.com/go/go1.27.1.linux-amd64.tar.gz | tar -C /usr/local -xz

ENV PATH="/usr/local/go/bin:${PATH}"
ENV CGO_ENABLED=0

# Create non-root user with throwaway home
RUN useradd -m -s /bin/bash testuser && \
    mkdir -p /home/testuser/go/pkg/mod && \
    chown -R testuser:testuser /home/testuser/go

USER testuser
ENV HOME=/home/testuser
ENV GOPATH=/home/testuser/go
ENV GOMODCACHE=/home/testuser/go/pkg/mod

WORKDIR /workspace

# Copy module files first for layer caching
COPY --chown=testuser:testuser go.mod go.sum ./
RUN go mod download

# Copy full source
COPY --chown=testuser:testuser . .

# Pre-build test binaries + fake-devpass-code for PATH
RUN mkdir -p /home/testuser/bin && \
    CGO_ENABLED=0 go build -o /home/testuser/bin/fake-devpass-code ./cmd/fake-devpass-code && \
    CGO_ENABLED=0 go build -o /home/testuser/bin/mock-discord ./cmd/mock-discord && \
    CGO_ENABLED=0 go build -o /home/testuser/bin/relay ./cmd/relay && \
    CGO_ENABLED=0 go build -o /home/testuser/bin/dpmux ./cmd/dpmux

ENV PATH="/home/testuser/bin:${PATH}"

CMD ["go", "test", "-tags", "integration", "-v", "./test/integration/..."]
